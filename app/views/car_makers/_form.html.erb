<%= form_with(model: @car_maker) do |form| %>
    <div><%= form.label :name %></div>
    <div><%= form.text_area :name %></div>
    <div><%= form.submit %></div>
    <% if show_timestamps %>
        <div>
            <p>登録日時: <%= car.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
            <p>編集日時: <%= car.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
        </div>
    <% end %>
<% end %>
