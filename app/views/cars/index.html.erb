<h1>車種管理画面(一覧)</h1>
<div>
    <% @cars.each do |model| %>
        <p>メーカー: <%= model.car_maker.name %></p>
        <p>車種: <%= model.name %></p>
        <p>販売開始年月: <%= model.sales_start_date %></p>
        <p>メモ: <%= model.memo %></p>
        <div><%= button_to "edit", edit_car_path(model), method: :get %></div>
        <div><%= button_to "delete", car_path(model), method: :delete %></div>
    <% end %>
</div>
<%= link_to "Add car", new_car_path %>
<%= link_to "Sales Management", sales_management_path %> 
