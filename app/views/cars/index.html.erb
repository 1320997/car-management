<h1>車種管理画面</h1>
<div><%= link_to "車両メーカー管理画面へ", car_makers_path %></div>
<div><%= link_to "車種販売管理画面へ", sales_management_path %></div><br>
<div><%= link_to "車両情報登録", new_car_path %></div>
<div>
    <% @cars.each do |model| %>
        <p>メーカー: <%= model.car_maker.name %></p>
        <p>車種: <%= model.name %></p>
        <p>販売開始年月: <%= model.sales_start_date %></p>
        <p>メモ: <%= model.memo %></p>
        <div><%= button_to "車両情報編集", edit_car_path(model), method: :get %></div>
        <div><%= button_to "車両情報削除", car_path(model), method: :delete %></div><br>
    <% end %>
</div>
