<%= form_with(model: @car) do |form| %>
    <div>
        <%= form.label :car_maker_id, "メーカー" %>
        <%= form.collection_select :car_maker_id, CarMaker.all, :id, :name %>
    </div>
    <div>
        <%= form.label :name %>
        <%= form.text_field :name %>
    </div>
    <div>
        <%= form.label :sales_start_date, "販売開始年月" %>
        <%= form.date_select :sales_start_date %>
    </div>
    <% if edit %>
        <div>
            <%= form.label :memo %>
            <%= form.text_area :memo %>
        </div>
    <% end %>
    <div>
        <%= form.submit %>
    </div>
    <% if edit %>
        <div>
            <p>登録日時: <%= car.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
            <p>編集日時: <%= car.updated_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
        </div>
    <% end %>
<% end %>
