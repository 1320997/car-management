<h1>車種販売管理画面</h1>
<div><%= link_to "車種管理画面へ戻る", cars_path %></div><br>
<%= form_with url: sales_management_path, method: :get, local: true do |form| %>
    <div>
        <%= form.label :selected_date, "販売可能年月" %>
        <%= form.select :selected_date, options_for_select(sales_date_options), prompt: "販売可能年月を選択" %>
        <%= form.label :selected_date, "に販売可能な車両" %>
    </div>
    <div>
        <%= form.submit "フィルターする" %>
    </div>
<% end %>

<div>
    <% @available_cars.each do |car| %>
        <p>メーカー: <%= car.car_maker.name %></p>
        <p>車種: <%= car.name %></p>
        <p>販売開始年月: <%= car.sales_start_date.strftime('%Y-%m') %></p>
        <p>メモ: <%= car.memo %></p><br>
    <% end %>
</div>
